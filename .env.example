APP_NAME=Laravel
# CATATAN: nilai di bawah adalah baseline PRODUCTION yang aman.
# Untuk pengembangan lokal, override: APP_ENV=local, APP_DEBUG=true,
# SESSION_SECURE_COOKIE=false, APP_URL=http://localhost
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Proxy/LB config (ISO: '*' jika di belakang nginx/CDN/ELB, atau daftar IP sumber)
TRUSTED_PROXIES=

# Host yang diperbolehkan (host header allow-list), dipisah koma.
# Default: semua subdomain dari APP_URL + localhost.
TRUSTED_HOSTS=

# Origin untuk CORS API (kosongkan untuk menonaktifkan CORS lintas-origin).
FRONTEND_URL=

# Cookie sesi harus Secure di production. Default otomatis true saat APP_ENV=production.
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meta WhatsApp Cloud API (provider: meta).
# Wajib diisi semua agar kirim pesan & webhook berjalan.
META_BUSINESS_ID=
META_VERIFY_TOKEN=
# ID Phone Number (bukan WABA ID!). Ambil di WhatsApp Manager > API Setup.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Wajib untuk provider meta: App Secret aplikasi Meta, dipakai memverifikasi
# X-Hub-Signature-256 pada setiap webhook masuk.
META_APP_SECRET=
META_API_VERSION=v26.0

WHATSAPP_PROVIDER=meta

# Password yang dipakai seeder akun (Owner/Admin/Kurir) saat generate akun.
# WAJIB ganti (bukan 'password') pada environment production.
SEED_ADMIN_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash